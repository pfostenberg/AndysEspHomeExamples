# Optional environment variables for local development and CI helpers.
# This project primarily uses ESPHome YAML files and esphome/secrets.yaml for runtime credentials.

# Path to the ESPHome config directory (default: ./esphome)
ESPHOME_CONFIG_DIR=./esphome

# Device config file used by helper scripts/commands (example)
ESPHOME_DEVICE_CONFIG=powmr1.yaml

# Optional: pin the ESPHome CLI version in local tooling
ESPHOME_VERSION=2024.12.0
